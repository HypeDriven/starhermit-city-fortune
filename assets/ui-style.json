    },
    ".art-frame": {
      "border": {
        "width": {
          "bottom": 3
        },
        "color": {
          "bottom": "$accent"
        },
        "style": "solid"
      },
      "radius": [10, 10, 0, 0]
    },
    ".btn": {
      "background": "#ffffff",
      "border": {
        "width": 1,
        "color": "$line",
        "style": "solid"
      },
      "radius": 10,
      "padding": {
        "top": 9,
        "end": 16,
        "bottom": 9,
        "start": 16
