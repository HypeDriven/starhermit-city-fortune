{
  "styles": {
    ".body": {
      "text": {
        "color": "$ink",
        "size": 16
      }
    },
    ".muted": {
      "text": {
        "color": "$muted",
        "size": 14.4
      }
    },
    ".small": {
      "text": {
        "color": "$muted",
        "size": 13
      }
    },
    ".tagline": {
      "text": {
        "color": "$muted",
        "size": 16
      }
    },
    ".h1": {
      "text": {
        "color": "$ink",
        "size": 30.4,
        "weight": "700",
        "letterSpacing": 0.6
      }
    },
    ".h1-small": {
      "text": {
        "color": "$ink",
        "size": 24,
        "weight": "700"
      }
    },
    ".h2": {
      "text": {
        "color": "$ink",
        "size": 17.6,
        "weight": "700"
      }
    },
    ".h3": {
      "text": {
        "color": "$ink",
        "size": 15.2,
        "weight": "700"
      }
    },
    ".panel": {
      "background": [
        {
          "image": "assets/paper-grain.webp",
          "size": [256, 256],
          "position": {
            "x": 0,
            "y": 0
          },
          "repeat": true
        },
        "$panel"
      ],
      "border": {
        "width": 1,
        "color": "$line",
        "style": "solid"
      },
      "radius": 10,
      "shadow": {
        "y": 6,
        "blur": 24,
        "color": "#3c2d142e"
      },
      "padding": {
        "top": 20,
        "end": 24,
        "bottom": 20,
        "start": 24
      }
    },
    ".panel-tight": {
      "padding": {
        "top": 14,
        "end": 16,
        "bottom": 14,
        "start": 16
      }
    },
    ".rail": {
      "background": [
        {
          "image": "assets/paper-grain.webp",
          "size": [256, 256],
          "position": {
            "x": 0,
            "y": 0
          },
          "repeat": true
        },
        "$panel"
      ],
      "border": {
        "width": 1,
        "color": "$line",
        "style": "solid"
      },
      "radius": 10,
      "padding": {
        "top": 10,
        "end": 12,
        "bottom": 10,
        "start": 12
      }
    },
    ".status-row": {
      "background": [
        {
          "image": "assets/paper-grain.webp",
          "size": [256, 256],
          "position": {
            "x": 0,
            "y": 0
          },
          "repeat": true
        },
        "$panel"
      ],
      "border": {
        "width": 1,
        "color": "$line",
        "style": "solid"
      },
      "radius": 10,
      "padding": {
        "top": 6,
        "end": 12,
        "bottom": 6,
        "start": 12
      }
    },
    ".status-item": {
      "text": {
        "color": "$ink",
        "size": 15.2,
        "weight": "600"
      }
    },
    ".lesson-card": {
      "background": "$panel",
      "border": {
        "width": 2,
        "color": "$accent",
        "style": "solid"
      },
      "radius": 10,
      "shadow": {
        "y": 8,
        "blur": 28,
        "color": "#3c2d144d"
      },
      "padding": {
        "top": 10,
        "end": 16,
        "bottom": 10,
        "start": 16
