      "minWidth": 44,
      "minHeight": 44,
      "text": {
        "color": "$ink",
        "size": 16,
        "align": "center"
      },
      "hovered": {
        "border": {
          "color": "$accent"
        }
      },
      "focusVisible": {
        "focusRing": {
          "width": 3,
          "color": "$focus",
          "offset": 2
        }
      },
      "disabled": {
        "opacity": 0.45
      }
    },
    ".btn-primary": {
      "background": "$accent",
      "border": {
        "color": "$accent"
      },
      "text": {
        "color": "$accent-ink",
        "weight": "600"
      },
      "hovered": {
        "border": {
          "color": "$ink"
        }
      }
    },
    ".btn-big": {
      "padding": {
        "top": 12,
        "end": 28,
        "bottom": 12,
        "start": 28
      },
      "text": {
        "size": 18.4
      }
